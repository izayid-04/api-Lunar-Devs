# Copy this file to .env for local development (it is loaded
# automatically via `dotenv`, only as a local dev convenience).
# On Hodifly, these are set in the app's Hodifly configuration panel
# (not in a .env file) and are injected into process.env at build AND
# runtime. Never commit real values.

# Port the HTTP server listens on. Hodifly/Passenger sets this
# automatically in production; only needed for local runs.
PORT=3000

# Front-end origin(s) allowed to call this API (CORS), comma-separated —
# list every origin that needs access (prod front, local dev ports, a
# Vercel URL later, etc.). Any http://localhost:<port> is ALSO always
# allowed in code regardless of this list, as a safety net.
FRONT_URL=https://lunardevs.lescomores.webcup.hodi.cloud,http://localhost:3000,http://localhost:3001

# Application name, used only to prove Hodifly env vars reach the app
# (surfaced by GET /health). Not a secret.
APP_NAME=api-lunar-devs

# MySQL connection, as separate variables (not a URL) to avoid password
# encoding issues. On Hodifly: host=localhost, port=3306,
# database=lunardevs_app, user=lunardevs_api (see docs/DEPLOIEMENT.md).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lunardevs_app
DB_USER=lunardevs_api
DB_PASSWORD=changeme

# Secret used to sign/verify JWTs (auth). Use a long random value in
# Hodifly — anyone with it can forge valid tokens for any role. Generate
# one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme

# Demo "agent" and "admin" accounts, created automatically at startup
# (idempotent — safe to leave set across restarts/redeploys) so the jury
# has working accounts for every role without a signup flow for them.
# Leaving a pair unset just skips creating that account (logged, no crash).
DEMO_AGENT_EMAIL=agent.demo@novaterra.local
DEMO_AGENT_PASSWORD=changeme
DEMO_ADMIN_EMAIL=admin.demo@novaterra.local
DEMO_ADMIN_PASSWORD=changeme
